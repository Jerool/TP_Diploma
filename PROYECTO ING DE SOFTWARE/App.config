<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <connectionStrings>
        <!--
            CONNECTION STRING - CAMBIAR LA INSTANCIA SEGÚN LA PC:
              - LocalDB (VS default):    Data Source=(localdb)\MSSQLLocalDB
              - SQL Server Express:      Data Source=.\SQLEXPRESS
              - Servidor con nombre:     Data Source=NOMBRE-PC\SQLEXPRESS
        -->
        <add name="GestionUsuario"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Gestion Usuario;Integrated Security=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>

    <!--
        ============================================================
        CONFIGURACIÓN DE EMAIL (para enviar facturas al cliente)
        ============================================================
        Mientras esta sección esté COMENTADA, el envío de emails está DESHABILITADO.
        La app funciona normal, solo que el botón "Enviar email" avisa que no está configurado.

        Para HABILITAR el envío por Gmail:
          1) Descomentá el bloque <system.net>...</system.net> de abajo.
          2) Reemplazá TU_CUENTA@gmail.com por tu cuenta de Gmail.
          3) Reemplazá TU_PASSWORD_APP por una "contraseña de aplicación" de 16 dígitos.
             (NO uses tu password de Gmail normal — no funciona con SMTP).
             Cómo generar: Cuenta de Google → Seguridad → Verificación en 2 pasos
                          → Contraseñas de aplicaciones → Generar
          4) Guardá y F5.

        Para OUTLOOK/Hotmail usá:
             host="smtp-mail.outlook.com" port="587" enableSsl="true"
    -->

    <!--
    <system.net>
        <mailSettings>
            <smtp deliveryMethod="Network" from="TechFlow &lt;TU_CUENTA@gmail.com&gt;">
                <network host="smtp.gmail.com" port="587" enableSsl="true"
                         defaultCredentials="false"
                         userName="TU_CUENTA@gmail.com" password="TU_PASSWORD_APP" />
            </smtp>
        </mailSettings>
    </system.net>
    -->

</configuration>
