<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--
        NOTA: La app NO usa connectionStrings del App.config.
        La instancia SQL la elige el usuario en FRMSeleccionInstancia
        y se guarda en %LocalAppData%\GestionUsuarios\conexion.cfg.
        Ver: Program.cs → ConfigurarConexionBD()
    -->
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
